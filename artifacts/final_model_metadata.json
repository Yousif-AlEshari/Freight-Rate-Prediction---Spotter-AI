{
  "model": "catboost_rpm_mae_no_quote",
  "parameters": {
    "target_mode": "rpm",
    "loss_function": "MAE",
    "include_quote_signal": false,
    "include_route": true,
    "distance_weighted_rpm": true,
    "iterations": 400,
    "depth": 7,
    "learning_rate": 0.05,
    "l2_leaf_reg": 5.0,
    "random_seed": 42
  },
  "training_rows": 48000,
  "training_date_min": "2025-01-01",
  "training_date_max": "2025-10-31",
  "model_features": [
    "pickup",
    "delivery",
    "equipment",
    "route",
    "pickup_lat",
    "pickup_lon",
    "delivery_lat",
    "delivery_lon",
    "distance",
    "log_distance",
    "weight",
    "weight_missing",
    "weight_was_negative",
    "market_index",
    "market_index_missing",
    "latitude_delta",
    "longitude_delta",
    "haversine_miles",
    "bearing_sin",
    "bearing_cos",
    "days_since_reference",
    "month",
    "quarter",
    "day_of_week",
    "day_of_year",
    "is_weekend",
    "day_of_week_sin",
    "day_of_week_cos",
    "day_of_year_sin",
    "day_of_year_cos"
  ],
  "december_market_source": "daily mean from unlabeled validation.csv",
  "versions": {
    "python": "3.12.3",
    "pandas": "2.3.3",
    "numpy": "2.5.3",
    "scikit_learn": "1.9.1",
    "catboost": "1.2.10"
  }
}
